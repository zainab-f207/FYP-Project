# Backend Configuration
# Copy this file to .env and update values as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Tesseract Configuration (Windows)
# Uncomment and set if Tesseract is not in PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# File Upload Limits
MAX_FILE_SIZE_MB=10

# OCR Configuration
OCR_LANGUAGE=urd
OCR_PSM=6  # Page segmentation mode (6 = Assume a single uniform block of text)
OCR_OEM=3  # OCR Engine Mode (3 = Default, based on what is available)

# Logging
LOG_LEVEL=INFO
