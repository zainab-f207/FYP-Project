# =====================================================================
# CrimeVision backend — env example
#
# Copy this file to `.env` and fill in real values for local dev.
# For Render deployment, set the same vars in the Render dashboard.
# Never commit `.env` — only `.env.example`.
# =====================================================================

# ── Runtime ──────────────────────────────────────────────────────────
ENV=development                  # use "production" on Render
LOG_LEVEL=INFO

# ── Database (MySQL) ─────────────────────────────────────────────────
# Local: point at your local MySQL.
# Production: TiDB Cloud Serverless, Aiven, or another free MySQL host.
#
# For TiDB Cloud, the values look like:
#   DB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
#   DB_PORT=4000          (TiDB uses 4000, not 3306)
#   DB_USER=<cluster_id>.root
#   DB_NAME=test
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-local-mysql-password
DB_NAME=crimevision_db

# Set DB_SSL_DISABLED=false when your DB host requires TLS (TiDB, Aiven).
# Leave "true" for local MySQL with no TLS.
DB_SSL_DISABLED=true
# Optional override; leave blank to auto-detect the system CA bundle on Linux.
DB_SSL_CA=

# ── CORS / URLs ──────────────────────────────────────────────────────
# Local dev: leave defaults. Production: set to your Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ── JWT secrets ──────────────────────────────────────────────────────
# REQUIRED in production — if missing, the server generates a new key
# every restart, which invalidates all existing tokens (users get
# logged out). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
REFRESH_SECRET_KEY=replace-with-a-different-long-random-string
JWT_SECRET=replace-with-yet-another-long-random-string

# ── SMTP (for OTP, password reset, alerts) ───────────────────────────
# Use a Gmail App Password (not your real password):
# https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ALERTS_EMAIL_USERNAME=your-alerts-email@gmail.com
ALERTS_EMAIL_PASSWORD=your-gmail-app-password
AUTH_EMAIL_USERNAME=your-auth-email@gmail.com
AUTH_EMAIL_PASSWORD=your-gmail-app-password
SUPER_ADMIN_EMAIL=admin@example.com

# ── Google OAuth ─────────────────────────────────────────────────────
# From https://console.cloud.google.com → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Browser push (VAPID) ─────────────────────────────────────────────
# Generate with the helper script: python app/generate_key.py
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com

# ── Law Section verification (LLM chain — Groq → OpenRouter) ─────────
# Used by app/routes/law_sections.py to validate extracted PPC sections.
# Groq is tried first (free 14,400 req/day), OpenRouter is the fallback.
#
# Groq: https://console.groq.com
GROQ_API_KEY=your-groq-api-key
# Provider 2: OpenRouter — free models, fallback if Groq blocked. Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# ── OCR vision APIs ──────────────────────────────────────────────────
# At least ONE of these is required for FIR OCR to work in production.
# All have free tiers — no credit card needed.
#
# Gemini (free 20 req/day): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Mistral (free ~1 req/sec): https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=pixtral-12b-2409

# OpenRouter for OCR extraction (separate quota from OPENROUTER_API_KEY
# above — this var is read only by the OCR module).
OPENROUTER_API_KEY_For_Extraction=your-openrouter-extraction-key
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ── Alert tuning (optional) ──────────────────────────────────────────
SAFE_AREA_MIN_SCORE=70
SEND_SAFE_ALERTS=True
SAFE_ALERT_COOLDOWN=60
