# =====================================================================
# CrimeVision frontend — env example
#
# Copy this file to `.env.local` for local dev (Vite reads `.env.local`
# automatically and it's gitignored). For Vercel, set these in the
# project's Environment Variables tab.
# =====================================================================

# Backend API URL.
# Local dev: http://localhost:8000
# Production: your Render backend URL (e.g. https://crimevision-backend.onrender.com)
#
# NOTE: the codebase reads BOTH names in different places — set both to
# the same value to avoid surprises.
VITE_API_BASE_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000

# Google OAuth client ID (must match GOOGLE_CLIENT_ID on the backend)
VITE_GOOGLE_CLIENT_ID=1062377219587-u12ic1km1lus47l8vl813mmib0p7cjsp.apps.googleusercontent.com

# Comma-separated list of origins allowed to postMessage this app.
# Local: usually fine to leave blank. Production: your Vercel URL.
VITE_ALLOWED_ORIGINS=
