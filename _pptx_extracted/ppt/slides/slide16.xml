></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="F4E9D8"/></a:solidFill><a:latin typeface="Consolas" pitchFamily="34" charset="0"/><a:ea typeface="Consolas" pitchFamily="34" charset="-122"/><a:cs typeface="Consolas" pitchFamily="34" charset="-120"/></a:rPr><a:t>RandomForestClassifier(</a:t></a:r><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="C8F751"/></a:solidFill><a:latin typeface="Consolas" pitchFamily="34" charset="0"/><a:ea typeface="Consolas" pitchFamily="34" charset="-122"/><a:cs typeface="Consolas" pitchFamily="34" charset="-120"/></a:rPr><a:t>  n_estimators     = 200,</a:t></a:r><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="C8F751"/></a:solidFill><a:latin typeface="Consolas" pitchFamily="34" charset="0"/><a:ea typeface="Consolas" pitchFamily="34" charset="-122"/><a:cs typeface="Consolas" pitchFamily="34" charset="-120"/></a:rPr><a:t>  max_depth        = 15,</a:t></a:r><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="C8F751"/></a:solidFill><a:latin typeface="Consolas" pitchFamily="34" charset="0"/><a:ea typeface="Consolas" pitchFamily="34" charset="-122"/><a:cs typeface="Consolas" pitchFamily="34" charset="-120"/></a:rPr><a:t>  min_samples_leaf = 10,</a:t></a:r><a:endParaRPr lang="en-US" sz="1200" dirty="0"/></a:p><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1200" dirty="0"><a:solidFill><a:srgbClr val="F4E9D8"/></a:solidFill><a:latin typeface="Consolas" pitchFamily="34" charset="0"/><a:ea typeface="Consolas" pitchFamily="34" charset="-122