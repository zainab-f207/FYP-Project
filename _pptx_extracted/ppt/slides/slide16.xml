5840" y="4389120"/><a:ext cx="4800600" cy="256032"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="900" b="1" spc="300" kern="0" dirty="0"><a:solidFill><a:srgbClr val="C8F751"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>WHAT THIS MEANS</a:t></a:r><a:endParaRPr lang="en-US" sz="900" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="13" name="Text 11"></p:cNvPr><p:cNvSpPr/><p:nvPr></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="1005840" y="4663440"/><a:ext cx="4800600" cy="1463040"/></a:xfrm><a:prstGeom prst="rect"><a:avLst></a:avLst></a:prstGeom><a:noFill/><a:ln></a:ln></p:spPr><p:txBody><a:bodyPr wrap="square" lIns="0" tIns="0" rIns="0" bIns="0" rtlCol="0" anchor="ctr"></a:bodyPr><a:lstStyle/><a:p><a:pPr indent="0" marL="0"><a:buNone/></a:pPr><a:r><a:rPr lang="en-US" sz="1100" i="1" dirty="0"><a:solidFill><a:srgbClr val="F4E9D8"/></a:solidFill><a:latin typeface="Calibri" pitchFamily="34" charset="0"/><a:ea typeface="Calibri" pitchFamily="34" charset="-122"/><a:cs typeface="Calibri" pitchFamily="34" charset="-120"/></a:rPr><a:t>Random Forest is like asking 200 different experts to look at a crime and say &apos;High, Medium, or Low risk&apos; — then taking the majority vote. Each expert (decision tree) sees a slightly different slice of the data, so they don&apos;t all make the same mistakes. We tell them not to dig deeper than 15 levels (avoids overfitting) and to weight rare cases more (Lahore has many more Low than High events).</a:t></a:r><a:endParaRPr lang="en-US" sz="1100" dirty="0"/></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="14" name="Shape